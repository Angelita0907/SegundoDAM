
/* QCheckBox --> estilos */

QCheckBox {
    color: #D989AE;
    font-size: 14px;
    spacing: 10px;
    padding: 5px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #D989AE;
    border-radius: 6px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border: 2px solid #260411;
    background-color: #F2F2F2;
}

QCheckBox::indicator:checked {
    background-color: #D989AE;
    border: 2px solid #D979A6;
    image: url(none);
}