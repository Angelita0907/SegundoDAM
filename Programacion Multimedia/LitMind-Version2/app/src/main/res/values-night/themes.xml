<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LitMind" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <!-- Splash Theme (sin ActionBar) -->
    <style name="Theme.LitMind.Splash" parent="Theme.LitMind">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Estilo para botones principales -->
    <style name="BotonPrincipal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_400</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Estilo para botones secundarios -->
    <style name="BotonSecundario" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/purple_400</item>
        <item name="android:textColor">@color/purple_400</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Estilo para cards -->
    <style name="CardView.LitMind" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Estilo para títulos -->
    <style name="TextAppearance.LitMind.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/gray_800</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Estilo para subtítulos -->
    <style name="TextAppearance.LitMind.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/gray_600</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Estilo para EditText -->
    <style name="EditText.LitMind" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/purple_400</item>
        <item name="hintTextColor">@color/gray_500</item>
    </style>


</resources>