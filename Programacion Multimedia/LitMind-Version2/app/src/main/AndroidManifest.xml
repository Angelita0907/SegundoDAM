<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LitMind">

        <!-- Splash - pantalla de inicio de la app -->
        <activity
            android:name=".PantallaCarga"
            android:exported="true"
            android:theme="@style/Theme.LitMind.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding - presentación inicial -->
        <activity android:name=".OnboardingActivity" android:exported="false" />

        <!-- Login -->
        <activity android:name=".LoginActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Registro -->
        <activity android:name=".RegisterActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Selección de rol tras registro -->
        <activity android:name=".RoleSelectionActivity" android:exported="false" />

        <!-- Pantalla principal de usuario (con bottom nav) -->
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- Secciones del bottom nav -->
        <activity android:name=".LibraryActivity" android:exported="false" />
        <activity android:name=".CommunityActivity" android:exported="false" />
        <activity android:name=".StatsActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".ReadingActivity" android:exported="false" />

        <!-- Panel de administración (solo admin) -->
        <activity android:name=".AdminActivity" android:exported="false" />

        <!-- Formulario crear/editar usuario (solo admin) -->
        <activity android:name=".UserDetailActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>
