<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#83F3B6EE">

    <!-- Creamos el titulo de nuestra app -->
    <TextView
        android:id="@+id/texto1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Peluquería"
        android:textStyle="bold"
        android:fontFamily="@font/fuente2"
        android:textSize="40dp"
        android:textColor="#673364"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints">
    </TextView>

    <!-- Ahora los elementos principales -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fuente1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/texto1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:fontFamily="@font/fuente3"
            android:hint="Nombre">
        </EditText>

        <EditText
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:fontFamily="@font/fuente3"
            android:hint="Teléfono">
        </EditText>
        <EditText
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:fontFamily="@font/fuente3"
            android:hint="Correo electrónico">
        </EditText>

        <EditText
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:fontFamily="@font/fuente3"
            android:hint="Dirección">
        </EditText>

        <!--Otro layout porsi queremos cancelar los cambios-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#8a5487"
                android:text="Guardar Datos">
            </Button>

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#a4a2a2"
                android:text="Cancelar"
                android:layout_marginStart="10dp">
            </Button>

        </LinearLayout>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>