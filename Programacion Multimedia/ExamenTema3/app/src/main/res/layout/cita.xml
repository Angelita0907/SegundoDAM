<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        android:background="#6690D5FF">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/fuente2"
            android:text="Pedir Cita"
            android:textColor="@color/azulito4"
            android:textSize="40dp"
            android:textStyle="bold" >

        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Selecciona la fecha y hora de su cita:"
            android:textSize="18dp" />

        <Button
            android:id="@+id/Fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Elegir Fecha"
            android:backgroundTint="@color/azulito3"/>

        <TextView
            android:id="@+id/fechaElegida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Fecha: Sin seleccionar"
            android:textSize="16sp"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/Confirmar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="Confirmar Cita"
            android:backgroundTint="@color/azulito2"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>