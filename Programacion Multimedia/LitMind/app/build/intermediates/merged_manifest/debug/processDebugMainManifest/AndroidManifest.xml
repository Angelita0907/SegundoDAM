<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="es.ejemplo.android.litmind"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="36" />

    <permission
        android:name="es.ejemplo.android.litmind.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="es.ejemplo.android.litmind.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.LitMind" >
        <activity
            android:name="es.ejemplo.android.litmind.RegisterActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.ReadingActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.StatsActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.CommunityActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.LibraryActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.LoginActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.RoleSelectionActivity"
            android:exported="false" />
        <activity
            android:name="es.ejemplo.android.litmind.MainActivity"
            android:exported="false" >
        </activity>
        <!--
 Desde aquí voy definir todas las activities que
         voy a usar en el proyecto y poco a poco iré añadiendo la lógica de cada una
        -->
        <!-- Splash Activity (Pantalla de inicio) -->
        <activity
            android:name="es.ejemplo.android.litmind.PantallaCarga"
            android:exported="true"
            android:theme="@style/Theme.LitMind.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="es.ejemplo.android.litmind.OnboardingActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="es.ejemplo.android.litmind.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>