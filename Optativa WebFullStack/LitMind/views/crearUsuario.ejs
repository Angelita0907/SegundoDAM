<%- include("template/cabecera", {subtitulo: "Nuevo Usuario"})%>

<div class="container">
    <h1>Crear nuevo Usuario</h1>
    <form action="/usuarios" class="my-2" method="POST">
        <input type="text" placeholder="Nombre" class="form-control my-2" name="nombre" required>
        
        <input type="text" placeholder="Nombre Completo" class="form-control my-2" name="nombreCompleto" required>
        
        <input type="number" placeholder="Edad" class="form-control my-2" name="edad" required>
        
        <div class="form-check my-2">
            <input class="form-check-input" type="checkbox" name="esDocente" id="esDocente">
            <label class="form-check-label" for="esDocente">
                Es Docente
            </label>
        </div>
        
        <input type="text" placeholder="Rol Principal (ej: ESTUDIANTE, PROFESOR)" class="form-control my-2" name="rolPrincipal" required>
        
        <input type="number" placeholder="Puntos por Logro" class="form-control my-2" name="puntosPortLogro" value="0">
        
        <select class="form-control my-2" name="tipoUsuario" required>
            <option value="">Selecciona Tipo de Usuario</option>
            <option value="AVANZADO">AVANZADO</option>
            <option value="INTERMEDIO">INTERMEDIO</option>
            <option value="PRINCIPIANTE">PRINCIPIANTE</option>
        </select>
        
        <button type="submit" class="btn btn-dark btn-block">
            Agregar Usuario
        </button>
    </form>
</div>

<%- include("template/footer")%>